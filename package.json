{
  "name": "keel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI Engineering Runtime — 让 AI、人工、多 Agent、多模型、多 Harness 在同一套软件研发流程中长期协作的运行层",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "tsx scripts/generate-types.ts",
    "db:migrate": "node-pg-migrate up",
    "db:reset": "node-pg-migrate down 0 && node-pg-migrate up",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "boundaries": "depcruise src scripts",
    "check:generated": "pnpm run generate && git diff --exit-code HEAD -- src/generated",
    "check:transitions": "tsx scripts/check-transition-table.ts",
    "check:purity": "tsx scripts/check-purity.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run boundaries && pnpm run check:generated && pnpm run check:transitions && pnpm run check:purity && pnpm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^16.0.0",
    "json-schema-to-typescript": "^15.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
