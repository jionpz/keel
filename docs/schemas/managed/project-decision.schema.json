{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project_id",
    "decision_key",
    "version",
    "statement",
    "selected_option_id",
    "options",
    "scope",
    "source_type",
    "source_ref",
    "created_by",
    "valid_from",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "project_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "decision_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "version": {"type": "integer", "minimum": 1},
    "statement": {"type": "string", "minLength": 1, "maxLength": 16000},
    "selected_option_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 100},
          "text": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_kinds", "actions", "resource_selectors", "environments", "reversibilities"],
      "properties": {
        "decision_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["*", "clarification", "preference", "design", "approval", "recovery", "budget"]}
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "resource_selectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["*", "local", "test", "staging", "production"]}
        },
        "reversibilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["*", "reversible", "partially_reversible", "irreversible"]}
        }
      }
    },
    "source_type": {"enum": ["owner_confirmed", "imported_candidate", "policy_default"]},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 1000},
    "created_by": {"type": "string", "minLength": 1, "maxLength": 200},
    "valid_from": {"type": "string", "minLength": 1, "maxLength": 64},
    "valid_until": {"type": "string", "minLength": 1, "maxLength": 64},
    "supersedes_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "superseded_by": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "revoked_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "revoked_by": {"type": "string", "minLength": 1, "maxLength": 200},
    "revocation_reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
