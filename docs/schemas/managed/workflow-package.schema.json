{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JstackInvestigationPackage",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "workflow_id", "mode", "source_commit", "stages", "instructions"],
  "properties": {
    "protocol_version": {"const": "1.0"}, "workflow_id": {"const": "jstack"},
    "mode": {"const": "investigation"}, "source_commit": {"type": "string", "minLength": 1, "maxLength": 100},
    "stages": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "execute"}},
    "instructions": {
      "type": "object", "additionalProperties": false, "required": ["route", "stages", "execute"],
      "properties": {
        "route": {"type": "string", "minLength": 1, "maxLength": 100000},
        "stages": {"type": "string", "minLength": 1, "maxLength": 50000},
        "execute": {"type": "string", "minLength": 1, "maxLength": 30000}
      }
    }
  }
}
