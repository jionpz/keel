{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManagedActionIntent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project_id",
    "repo_id",
    "task_id",
    "action",
    "remote_url",
    "base_branch",
    "head_branch",
    "head_sha",
    "diff_digest",
    "environment",
    "reversibility",
    "affected_resources",
    "pr_title",
    "pr_body",
    "idempotency_key",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "repo_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "action": {
      "const": "push_and_pr"
    },
    "remote_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "base_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "head_branch": {
      "type": "string",
      "pattern": "^ai/[A-Za-z0-9._/-]+$",
      "maxLength": 300
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "diff_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment": {
      "enum": [
        "local",
        "test",
        "staging",
        "production"
      ]
    },
    "reversibility": {
      "enum": [
        "reversible",
        "partially_reversible",
        "irreversible"
      ]
    },
    "affected_resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "pr_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "pr_body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_revision",
        "resolution_id",
        "digest"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "request_revision": {
          "type": "integer",
          "minimum": 1
        },
        "resolution_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
