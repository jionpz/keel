{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelegationPolicyVersion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "policy_id",
    "version",
    "project_id",
    "approved_by_owner",
    "approved_at",
    "valid_from",
    "rules",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "version": {"type": "integer", "minimum": 1},
    "project_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "approved_by_owner": {"type": "string", "minLength": 1, "maxLength": 200},
    "approved_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "valid_from": {"type": "string", "minLength": 1, "maxLength": 64},
    "valid_until": {"type": "string", "minLength": 1, "maxLength": 64},
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision_kinds",
          "actions",
          "resource_selectors",
          "environments",
          "reversibility",
          "impact_limits",
          "budget_limits",
          "required_evidence",
          "required_checks",
          "mode"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "decision_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["*", "clarification", "preference", "design", "approval", "recovery", "budget"]}
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "resource_selectors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          },
          "environments": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["*", "local", "test", "staging", "production"]}
          },
          "reversibility": {"enum": ["reversible", "partially_reversible", "irreversible"]},
          "impact_limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["environments", "reversibilities", "max_affected_resources"],
            "properties": {
              "environments": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["local", "test", "staging", "production"]}
              },
              "reversibilities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["reversible", "partially_reversible", "irreversible"]}
              },
              "max_affected_resources": {"type": "integer", "minimum": 1, "maximum": 64}
            }
          },
          "budget_limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_cost_usd": {"type": "number", "minimum": 0},
              "max_tokens": {"type": "integer", "minimum": 0},
              "max_attempts": {"type": "integer", "minimum": 1}
            }
          },
          "required_evidence": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "required_checks": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "mode": {"enum": ["delegated", "owner_required", "deny"]},
          "default_option_id": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      }
    },
    "supersedes_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "superseded_by": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "revoked_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "revoked_by": {"type": "string", "minLength": 1, "maxLength": 200},
    "revocation_reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
