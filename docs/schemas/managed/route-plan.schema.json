{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JstackRoutePlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route_size", "summary", "tickets"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "route_size": {"enum": ["XS", "S", "M", "L", "XL"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 16000},
    "tickets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "ticket_id",
          "title",
          "size",
          "depends_on",
          "scope_paths",
          "acceptance"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "ticket_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "external_issue": {"type": "string", "minLength": 1, "maxLength": 300},
          "title": {"type": "string", "minLength": 1, "maxLength": 1000},
          "description": {"type": "string", "minLength": 1, "maxLength": 20000},
          "size": {"enum": ["XS", "S", "M", "L", "XL"]},
          "depends_on": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,63}$"
            }
          },
          "scope_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 500}
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {"type": "string", "minLength": 1, "maxLength": 4000}
          }
        }
      }
    }
  }
}
