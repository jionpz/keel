{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "idempotency_key",
    "project_id",
    "repo_id",
    "decision_key",
    "kind",
    "question",
    "options",
    "constraints",
    "missing_information",
    "impact",
    "action_category",
    "input_digest",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 300},
    "project_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "repo_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "managed_task_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "managed_question_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "task_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "decision_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "kind": {"enum": ["clarification", "preference", "design", "approval", "recovery", "budget"]},
    "question": {"type": "string", "minLength": 1, "maxLength": 16000},
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 100},
          "text": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    },
    "suggested_option_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "constraints": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "missing_information": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "reversibility", "affected_resources"],
      "properties": {
        "environment": {"enum": ["local", "test", "staging", "production"]},
        "reversibility": {"enum": ["reversible", "partially_reversible", "irreversible"]},
        "affected_resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "action_category": {"type": "string", "minLength": 1, "maxLength": 128},
    "workflow_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_memory_epoch": {"type": "integer", "minimum": 0},
    "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["OPEN", "PROCESSING", "WAITING_HUMAN", "RESOLVED", "CANCELLED", "SUPERSEDED"]},
    "expires_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
