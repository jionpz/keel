{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManagedExecutionPermit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "action_intent_id",
    "project_id",
    "repo_id",
    "action",
    "authorization",
    "expected_sha",
    "diff_digest",
    "target_digest",
    "environment",
    "fencing_token",
    "idempotency_key",
    "issued_at",
    "expires_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "action_intent_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "repo_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "action": {
      "const": "push_and_pr"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "rule_id",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "delegation_policy"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "expected_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "diff_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment": {
      "enum": [
        "local",
        "test",
        "staging",
        "production"
      ]
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "expires_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "enum": [
        "VALID",
        "CONSUMED",
        "REVOKED",
        "EXPIRED"
      ]
    }
  }
}
