{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TianwenSuggestion",
  "type": "object", "additionalProperties": false,
  "required": ["recommendation", "rationale", "missing_information"],
  "properties": {
    "recommendation": {"type": "string", "minLength": 1, "maxLength": 4000},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
    "missing_information": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  }
}
