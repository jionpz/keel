{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoVerificationContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "checks"],
  "properties": {
    "version": {"const": "1"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "argv"],
            "properties": {
              "id": {"$ref": "#/$defs/checkId"},
              "paths": {"$ref": "#/$defs/checkPaths"},
              "kind": {"const": "local"},
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "maxLength": 1000, "pattern": "^[^\\u0000\\r\\n]*$"}
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "name"],
            "properties": {
              "id": {"$ref": "#/$defs/checkId"},
              "paths": {"$ref": "#/$defs/checkPaths"},
              "kind": {"const": "remote"},
              "name": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000\\r\\n]+$"}
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "checkId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "checkPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  }
}
